# RippleCheck Root Environment Configuration
# Copy this file to .env and configure your local settings

# Neo4j Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# AI Service Provider (e.g., ollama, gemini)
AI_PROVIDER=ollama

# Firebase Admin SDK Configuration (Optional: file path or base64 JSON, or GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_PROJECT_ID=ripplecheck-4c3ca


