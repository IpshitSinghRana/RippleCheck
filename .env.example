# RippleCheck Root Environment Configuration
# Copy this file to .env and configure your local settings

# Server Port and Host
# PORT=3000
# HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list for production, e.g. https://ripplecheck.app,https://preview.ripplecheck.app)
# ALLOWED_ORIGINS=https://your-frontend-domain.com

# Neo4j Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# AI Service Provider: "gemini" (Production cloud) or "ollama" (Local development)
AI_PROVIDER=gemini

# Google Gemini AI Provider Configuration (Required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama AI Provider Configuration (Used when AI_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=qwen2.5-coder:3b

# Firebase Admin SDK Configuration (Optional: file path, base64 JSON, or GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_PROJECT_ID=ripplecheck-4c3ca
