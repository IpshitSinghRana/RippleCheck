# RippleCheck Frontend Configuration
# Copy this file to frontend/.env and configure your environment

# Remote API base URL for production deployments (defaults to '/api' for local Vite proxy)
# In production, set to your deployed backend origin, e.g. https://api.ripplecheck.app/api
VITE_API_BASE_URL=/api

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
